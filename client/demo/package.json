{
    "name": "demo",
    "version": "1.0.0",
    "description": "",
    "private": true,
    "scripts": {
        "clean": "rimraf dist/",
        "webpack:prod": "npx webpack --config webpack.prod.js",
        "webpack:dev": "npx webpack --config webpack.dev.js",
        "build:prod": "npm-run-all clean webpack:prod",
        "build:dev": "npm-run-all clean webpack:dev",
        "start": "webpack-dev-server  --config webpack.dev.js",
        "build:mod": "cd ../lib && npm run build:dev && cd ../demo && npm run build:mod_copy",
        "build:mod_copy": "node -e \"const fs = require('fs'); const target = 'node_modules/@dannadori/voice-changer-client-js'; fs.rmSync(target + '/dist', { recursive: true, force: true }); fs.cpSync('../lib/dist', target + '/dist', { recursive: true }); fs.copyFileSync('../lib/package.json', target + '/package.json');\"",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "voice conversion"
    ],
    "author": "wataru.okada@flect.co.jp",
    "license": "ISC",
    "devDependencies": {
        "@babel/core": "^7.23.5",
        "@babel/plugin-transform-runtime": "^7.23.4",
        "@babel/preset-env": "^7.23.5",
        "@babel/preset-react": "^7.23.3",
        "@babel/preset-typescript": "^7.23.3",
        "@types/node": "^24.0.0",
        "@types/react": "^18.2.40",
        "@types/react-dom": "^18.2.17",
        "autoprefixer": "^10.4.16",
        "babel-loader": "^9.1.3",
        "copy-webpack-plugin": "^11.0.0",
        "css-loader": "^6.8.1",
        "html-loader": "^4.2.0",
        "html-webpack-plugin": "^5.5.3",
        "npm-run-all": "^4.1.5",
        "postcss-loader": "^7.3.3",
        "postcss-nested": "^6.0.1",
        "prettier": "^3.1.0",
        "rimraf": "^5.0.5",
        "style-loader": "^3.3.3",
        "typescript": "^5.3.2",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^4.15.1",
        "webpack-merge": "^5.10.0"
    },
    "dependencies": {
        "@babel/runtime": "^7.23.5",
        "@dannadori/voice-changer-client-js": "1.0.180",
        "@dannadori/worker-manager": "^1.0.20",
        "@fortawesome/fontawesome-svg-core": "^6.5.1",
        "@fortawesome/free-brands-svg-icons": "^6.5.1",
        "@fortawesome/free-regular-svg-icons": "^6.5.1",
        "@fortawesome/free-solid-svg-icons": "^6.5.1",
        "@fortawesome/react-fontawesome": "^0.2.0",
        "buffer": "^6.0.3",
        "chart.js": "^4.4.3",
        "react": "^18.2.0",
        "react-chartjs-2": "^5.2.0",
        "react-dom": "^18.2.0",
        "react-toastify": "^10.0.5",
        "react-tooltip": "^5.27.1"
    }
}
